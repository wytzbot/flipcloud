PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub sign-in is handled entirely by Firebase Authentication's GitHub
# provider (configured in the Firebase console, not here). If you later add
# repository access (read/write to repos), use a Personal Access Token
# rather than a GitHub App:
# GITHUB_TOKEN=

# Flutterwave v4 billing
FLW_ENV=sandbox
# Optional override if Flutterwave changes the v4 base host
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# Hosted subscription enrollment (Flutterwave Standard payment plans).
# Only the secret key is actually used server-side; the public key is not
# required by this app (it's only needed for client-side/Inline checkout,
# which this app doesn't use).
FLW_SECRET_KEY=
FLW_MONTHLY_PLAN_ID=
FLW_YEARLY_PLAN_ID=
FLW_REDIRECT_URL=http://localhost:3000/billing-callback

PUBLIC_APP_URL=https://YOUR-DOMAIN
FLW_SECRET_HASH=replace-with-random-flutterwave-webhook-secret
FLW_ALLOW_V3_WEBHOOK=false
# Optional Firebase Admin persistence for production subscriptions/FCM
# Firebase Admin persistence (recommended for production subscriptions + FCM)
FIREBASE_PROJECT_ID=flipcloud
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared secret protecting the internal /api/billing/v4/* routes
# (checked against the x-flipcloud-billing-key header). Only needed if you
# add a service that calls those routes directly.
FLIPCLOUD_INTERNAL_BILLING_KEY=

# Pro free trial length in days (default 7). Trials and daily free-tier
# quotas are stored in Firestore, so set the FIREBASE_* variables above in production.
TRIAL_DAYS=7
