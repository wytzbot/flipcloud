PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Flutterwave v4 billing
FLW_ENV=sandbox
# Optional override if Flutterwave changes the v4 base host
FLW_BASE_URL=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# Hosted subscription enrollment (Flutterwave Standard payment plans)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_MONTHLY_PLAN_ID=
FLW_YEARLY_PLAN_ID=
FLW_REDIRECT_URL=http://localhost:3000/billing-callback

PUBLIC_APP_URL=https://YOUR-DOMAIN
FLW_SECRET_HASH=replace-with-random-flutterwave-webhook-secret
FLW_ALLOW_V3_WEBHOOK=false
# Optional Firebase Admin persistence for production subscriptions/FCM
# Firebase Admin persistence (recommended for production subscriptions + FCM)
FIREBASE_PROJECT_ID=flipcloud
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FLIPCLOUD_INTERNAL_BILLING_KEY=

